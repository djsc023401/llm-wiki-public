APP_DB_PASSWORD=change-me
APP_UID=1000
APP_GID=1000
LLM_WIKI_SOURCE_ROOT=/home/YOUR_USER/projects/llm-wiki
# LLM_WIKI_MIRROR_ROOT=/home/YOUR_USER/services/llm-wiki-app/mirror
# APP_API_TOKEN은 기존 호환용입니다. 아래의 외부 클라이언트/관리자 토큰 분리를 권장합니다.
# APP_API_TOKEN=change-me
# change-me*, placeholder, replace-me* 예제값은 실제 실행 시 거부됩니다.
APP_PLUGIN_TOKEN=change-me-client
APP_ADMIN_TOKEN=change-me-admin
APP_DATABASE_URL=postgresql://llm_wiki:change-me@app-db:5432/llm_wiki
APP_BASE_URL=https://notes.example.com
APP_REPO_FULL_NAME=local/llm-wiki
APP_DEFAULT_WORKFLOW_MODE=generic
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_MAX_REQUEST_SNAPSHOT_BYTES=262144
APP_MAX_ATTACHMENT_BYTES=10485760
MIRROR_PATH=/vault

# Object storage.
# 내장 MinIO profile을 쓰려면 이 기본값을 유지하고 `docker compose --profile minio ...`로 실행합니다.
# 외부 S3/기존 MinIO를 쓰려면 S3_ENDPOINT와 credential을 해당 서비스 값으로 바꿉니다.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=llm-wiki
S3_ACCESS_KEY_ID=llm-wiki-minio
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_REGION=us-east-1
MINIO_ROOT_USER=llm-wiki-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_BUCKET=llm-wiki
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_PORT=9001

# Backup/restore smoke.
# run-backup.sh가 임시 Postgres를 띄워 DB dump 복원을 검증할 때 사용합니다.
RESTORE_SMOKE_ENABLED=true
RESTORE_SMOKE_DB_PASSWORD=change-me-restore-smoke
REPO_BUNDLE_BACKUP_ENABLED=false

HOME=/data
CODEX_HOME=/data/codex
CODEX_CLI_COMMAND=codex
CODEX_CLI_EXEC_ARGS=--dangerously-bypass-approvals-and-sandbox
CODEX_RUN_ROOT=/data/codex-runs
CODEX_RUN_LOG_LIMIT_BYTES=200000
WORKER_INTERVAL=15
WORKER_RUNNER=dry-run
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_SECONDS=300
WORKER_HEARTBEAT_INTERVAL=15
DB_NOTE_RUN_ROOT=/data/db-note-runs
WORKER_MAX_CHANGED_FILES=5
WORKER_MAX_DIFF_BYTES=200000
WORKER_DB_NOTE_AUTO_EXPORT_ENABLED=false
TIME_SUGGESTION_AUTO_REGISTER_ENABLED=false

# 선택적 Markdown mirror Git push.
# 기본 운영에서는 로컬 mirror 생성만 사용하고 push는 꺼둡니다.
MIRROR_GIT_PUSH_ENABLED=false
# VAULT_PATH=/vault

# 알림 채널.
# PWA 푸시에는 고정 VAPID 키 쌍이 필요합니다. 비공개 키는 외부에 노출하지 않습니다.
NOTIFICATION_DISPATCH_ENABLED=true
DAILY_DIGEST_ENABLED=false
PWA_VAPID_PUBLIC_KEY=
PWA_VAPID_PRIVATE_KEY=
PWA_VAPID_PRIVATE_KEY_FILE=
PWA_VAPID_SUBJECT=mailto:admin@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET_FILE=
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_POLLING_TIMEOUT_SECONDS=5
TELEGRAM_POLLING_INTERVAL_SECONDS=2
TELEGRAM_POLLING_LIMIT=20
TELEGRAM_POLLING_OFFSET_PATH=/data/telegram-polling-offset.json
TELEGRAM_POLLING_DELETE_WEBHOOK_ON_CONFLICT=true

# API/SDK 러너 프로토타입.
# 서버 측 API 키를 설치하고 1회 스모크를 통과하기 전까지 비활성화합니다.
OPENAI_API_RUNNER_ENABLED=false
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_API_MODEL=gpt-5.5
OPENAI_API_TIMEOUT_SECONDS=1800
OPENAI_API_MAX_OUTPUT_TOKENS=8192
OPENAI_API_REASONING_EFFORT=low
OPENAI_API_RUN_ROOT=/data/openai-api-runs

# 선택형 대화 답변 제공자.
# 검색, 순위, 근거는 결정적 로직으로 유지하고 대화형 답변 문장만 바꿉니다.
# 서버 전용 OpenAI API 키 파일을 설치하기 전까지 rules를 유지합니다.
CHAT_ANSWER_PROVIDER=rules
CHAT_ANSWER_OPENAI_MODEL=gpt-5.4-mini
CHAT_ANSWER_OPENAI_API_KEY=
CHAT_ANSWER_OPENAI_API_KEY_FILE=
CHAT_ANSWER_OPENAI_TIMEOUT_SECONDS=60
CHAT_ANSWER_OPENAI_MAX_OUTPUT_TOKENS=1200
CHAT_ANSWER_OPENAI_REASONING_EFFORT=low
CHAT_ANSWER_OPENAI_MAX_EVIDENCE_ITEMS=12
CHAT_ANSWER_OPENAI_MAX_PROMPT_CHARS=24000
CHAT_ANSWER_OPENAI_INPUT_COST_PER_1M_TOKENS=
CHAT_ANSWER_OPENAI_OUTPUT_COST_PER_1M_TOKENS=
